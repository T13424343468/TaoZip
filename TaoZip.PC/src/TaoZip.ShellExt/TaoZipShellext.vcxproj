<?xml version="1.0" encoding="utf-8"?>
<!--
  TaoZipShellext: IExplorerCommand COM DLL for the Win11 modern context menu
  (2026-11-15 boss order: dynamic button in File Explorer).
  Zero Chinese in identifiers/resource names (naming iron law); visible text is
  zh-CN via String Resources. Build: VS2022 C++ toolset, x64.
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)'==''">Release</Configuration>
    <Platform Condition="'$(Platform)'==''">x64</Platform>
    <PlatformToolset>v143</PlatformToolset>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <CharacterSet>Unicode</CharacterSet>
    <OutDir>$(SolutionDir)bin\$(Configuration)\$(Platform)\ShellExt\</OutDir>
    <IntDir>$(OutDir)obj\</IntDir>
    <TargetName>TaoZipShellext</TargetName>
    <UseOfMfc>false</UseOfMfc>
  </PropertyGroup>
  <ItemGroup>
    <ClCompile Include="dllmain.cpp" />
    <ClCompile Include="TaoZipCommands.cpp" />
    <ClCompile Include="$(IntDir)TaoZipShellext_i.c" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="TaoZipCommands.h" />
    <Midl Include="TaoZipShellext.idl" />
    <None Include="resource.h" />
    <None Include="TaoZipShellext.rc" />
  </ItemGroup>
  <ItemGroup>
    <ResourceCompile Include="TaoZipShellext.rc" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="app.ico">
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <PropertyGroup>
    <ModuleDefinitionFile>TaoZipShellext.def</ModuleDefinitionFile>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ItemDefinitionGroup>
    <ClCompile>
      <PreprocessorDefinitions>_USRDLL;TAOZIPSHELLEXT_EXPORTS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <AdditionalOptions>/await:switch /utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <ModuleDefinitionFile>TaoZipShellext.def</ModuleDefinitionFile>
      <AdditionalDependencies>windowsapp.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
